# Copy to .env and fill in. Never commit .env.

# Resend API key used to send the host notification and the guest confirmation.
RESEND_API_KEY=

# Absolute path of the JSON file that stores bookings. Required in production.
# In Docker this is the mounted volume.
BOOKINGS_FILE=/data/bookings.json

# Set to 1 to log emails instead of sending them (local development).
# EMAIL_DRY_RUN=1

# Name of the header your reverse proxy sets to the visitor's IP address, for
# example x-forwarded-for or cf-connecting-ip. Leave unset when the app is
# reachable directly: without a trusted proxy the header could be forged, so
# per-IP rate limiting stays off.
# TRUSTED_IP_HEADER=x-forwarded-for
